diff --git a/Networking/ssl_sockets.h b/Networking/ssl_sockets.h
--- a/Networking/ssl_sockets.h
+++ b/Networking/ssl_sockets.h
@@ -27,7 +27,19 @@ class ssl_ctx : public boost::asio::ssl::context
 public:
     ssl_ctx(string me) :
-            boost::asio::ssl::context(boost::asio::ssl::context::tlsv12)
+            boost::asio::ssl::context(boost::asio::ssl::context::tls)
     {
+        // ZKFMI integration: the upstream OpenSSL implementation performs
+        // X25519 + ML-KEM-768. Unsupported peers and libraries fail closed.
+        auto* ctx = native_handle();
+        if (SSL_CTX_set_min_proto_version(ctx, TLS1_3_VERSION) != 1
+                || SSL_CTX_set_max_proto_version(ctx, TLS1_3_VERSION) != 1
+                || SSL_CTX_set1_groups_list(ctx, "X25519MLKEM768") != 1)
+            throw std::runtime_error("MP-SPDZ requires X25519MLKEM768 TLS 1.3");
+        // A reconnect must perform a fresh hybrid exchange. This context
+        // serves persistent MPC channels, not one handshake per instruction.
+        SSL_CTX_set_options(ctx, SSL_OP_NO_TICKET);
+        SSL_CTX_set_session_cache_mode(ctx, SSL_SESS_CACHE_OFF);
+
         string prefix = SSL_DIR + me;
         string cert_file = prefix + ".pem";
         string key_file = prefix + ".key";
